{
  "expo": {
    "name": "Swarupa Panchang",
    "slug": "swarupa-panchang",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "swarupa-panchang",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D1B25"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.swarupa.panchang",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSUserNotificationsUsageDescription": "Swarupa Panchang sends daily sunrise alerts with Tithi, Nakshatra and festival information, and reminds you of upcoming Ekadashi fasts."
      }
    },
    "android": {
      "package": "com.swarupa.panchang",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#D4A843",
          "sounds": [],
          "androidMode": "default",
          "androidCollapsedTitle": "Swarupa Panchang"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "2571b921-c29f-423c-9e8d-ada4652efd03"
      }
    },
    "owner": "ashishchauhan9596"
  }
}
